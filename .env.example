# Futbol Market — Telegram bot sozlamalari
# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni yozing.
# DIQQAT: .env faylini hech kimga yubormang (ichida token bor).

# @BotFather dan olingan token
BOT_TOKEN=

# Buyurtma xabarlari keladigan chat ID (bir nechta bo'lsa vergul bilan: 123,456)
# Bilmasangiz bo'sh qoldiring: botga /start yuboring, u ID ni aytadi.
ADMIN_CHAT_ID=

# Saytingizning internetdagi manzili (https://...). Bo'sh qolsa "Saytga o'tish" tugmasi chiqmaydi.
PUBLIC_URL=

# Telegram Mini App manzili (telegram-app papkasi joylangan https:// manzil).
# "node setup-bot.js <manzil>" buni o'zi yozadi.
WEBAPP_URL=
